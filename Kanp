# Program 2: Minimum Cost Spanning Tree using Prim's Algorithm

```c
#include <stdio.h>
#include <limits.h>

#define MAX 20

int minKey(int key[], int mstSet[], int V) {
    int min = INT_MAX;
    int min_index = -1;

    for(int v = 0; v < V; v++) {
        if(mstSet[v] == 0 && key[v] < min) {
            min = key[v];
            min_index = v;
        }
    }

    return min_index;
}

void printMST(int parent[], int graph[MAX][MAX], int V) {
    int total = 0;

    printf("
Edges in Minimum Spanning Tree:
");
    printf("Edge 	Weight
");

    for(int i = 1; i < V; i++) {
        printf("%c - %c 	%d
", parent[i] + 'A', i + 'A', graph[i][parent[i]]);
        total += graph[i][parent[i]];
    }

    printf("
Total Weight = %d
", total);
}

void primMST(int graph[MAX][MAX], int V) {
    int parent[MAX];
    int key[MAX];
    int mstSet[MAX];

    for(int i = 0; i < V; i++) {
        key[i] = INT_MAX;
        mstSet[i] = 0;
    }

    key[0] = 0;
    parent[0] = -1;

    for(int count = 0; count < V - 1; count++) {
        int u = minKey(key, mstSet, V);

        if(u == -1) {
            break;
        }

        mstSet[u] = 1;

        for(int v = 0; v < V; v++) {
            if(graph[u][v] != 0 && mstSet[v] == 0 && graph[u][v] < key[v]) {
                parent[v] = u;
                key[v] = graph[u][v];
            }
        }
    }

    printMST(parent, graph, V);
}

int main() {
    int V;
    int graph[MAX][MAX];

    printf("Enter number of vertices: ");
    scanf("%d", &V);

    printf("Enter adjacency matrix:
");

    for(int i = 0; i < V; i++) {
        for(int j = 0; j < V; j++) {
            scanf("%d", &graph[i][j]);
        }
    }

    printf("
Prim's Minimum Spanning Tree:
");

    primMST(graph, V);

    return 0;
}
