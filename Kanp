#include <stdio.h>

struct Item {
    int profit;
    int weight;
    float ratio;
};

void sortByProfit(struct Item item[], int n) {

    int i, j;
    struct Item temp;

    for(i = 0; i < n - 1; i++) {

        for(j = i + 1; j < n; j++) {

            if(item[i].profit < item[j].profit) {

                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }
}

void sortByWeight(struct Item item[], int n) {

    int i, j;
    struct Item temp;

    for(i = 0; i < n - 1; i++) {

        for(j = i + 1; j < n; j++) {

            if(item[i].weight > item[j].weight) {

                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }
}

void sortByRatio(struct Item item[], int n) {

    int i, j;
    struct Item temp;

    for(i = 0; i < n - 1; i++) {

        for(j = i + 1; j < n; j++) {

            if(item[i].ratio < item[j].ratio) {

                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }
}

void fractionalKnapsack(struct Item item[], int n, int m) {

    float x[n];
    int i;
    int remaining = m;
    float totalProfit = 0;

    for(i = 0; i < n; i++) {
        x[i] = 0;
    }

    for(i = 0; i < n; i++) {

        if(item[i].weight <= remaining) {

            x[i] = 1.0;

            remaining =
                remaining - item[i].weight;

            totalProfit =
                totalProfit + item[i].profit;
        }
        else {

            x[i] =
                (float)remaining / item[i].weight;

            totalProfit =
                totalProfit +
                (x[i] * item[i].profit);

            break;
        }
    }

    printf("\nSolution Vector:\n");

    for(i = 0; i < n; i++) {

        printf("x%d = %.2f\n", i + 1, x[i]);
    }

    printf("\nMaximum Profit = %.2f\n",
           totalProfit);
}

int main() {

    int n, m;
    int i, choice;

    printf("Enter number of objects: ");
    scanf("%d", &n);

    struct Item item[n];

    printf("Enter knapsack capacity: ");
    scanf("%d", &m);

    printf("Enter profits:\n");

    for(i = 0; i < n; i++) {

        scanf("%d", &item[i].profit);
    }

    printf("Enter weights:\n");

    for(i = 0; i < n; i++) {

        scanf("%d", &item[i].weight);

        item[i].ratio =
            (float)item[i].profit /
            item[i].weight;
    }

    printf("\n1. Sort by Profit");
    printf("\n2. Sort by Weight");
    printf("\n3. Sort by Profit/Weight Ratio");

    printf("\n\nEnter your choice: ");
    scanf("%d", &choice);

    switch(choice) {

        case 1:
            sortByProfit(item, n);

            printf("\nKnapsack by Maximum Profit\n");

            fractionalKnapsack(item, n, m);

            break;

        case 2:
            sortByWeight(item, n);

            printf("\nKnapsack by Minimum Weight\n");

            fractionalKnapsack(item, n, m);

            break;

        case 3:
            sortByRatio(item, n);

            printf("\nKnapsack by Maximum Profit/Weight Ratio\n");

            fractionalKnapsack(item, n, m);

            break;

        default:
            printf("\nInvalid Choice");
    }

    return 0;
}

