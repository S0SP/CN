# Program 1: Fractional Knapsack Problem (Greedy Method)

```c
#include <stdio.h>

struct Item {
    int profit;
    int weight;
    float ratio;
};

void sortByRatio(struct Item item[], int n) {
    int i, j;
    struct Item temp;

    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {
            if(item[i].ratio < item[j].ratio) {
                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }
}

int main() {
    int n, m;
    int i;
    float totalProfit = 0.0;
    int totalWeight = 0;

    printf("Enter number of objects: ");
    scanf("%d", &n);

    struct Item item[n];
    float x[n];

    printf("Enter knapsack capacity: ");
    scanf("%d", &m);

    printf("Enter profits:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &item[i].profit);
    }

    printf("Enter weights:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &item[i].weight);
    }

    for(i = 0; i < n; i++) {
        item[i].ratio = (float)item[i].profit / item[i].weight;
        x[i] = 0.0;
    }

    sortByRatio(item, n);

    int U = m;

    for(i = 0; i < n; i++) {
        if(item[i].weight <= U) {
            x[i] = 1.0;
            totalWeight += item[i].weight;
            totalProfit += item[i].profit;
            U = U - item[i].weight;
        }
        else {
            x[i] = (float)U / item[i].weight;
            totalWeight += U;
            totalProfit += x[i] * item[i].profit;
            break;
        }
    }

    printf("\nSolution Vector:\n");
    for(i = 0; i < n; i++) {
        printf("x[%d] = %.2f\n", i + 1, x[i]);
    }

    printf("\nTotal Weight = %d\n", totalWeight);
    printf("Maximum Profit = %.2f\n", totalProfit);

    return 0;
}
```

