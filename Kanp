// Fractional Knapsack using
// 1. Maximum Profit
// 2. Minimum Weight
// 3. Maximum Profit/Weight Ratio

#include <stdio.h>

struct Item {
    int profit;
    int weight;
    float ratio;
};

void copyItems(struct Item source[], struct Item dest[], int n) {
    int i;

    for(i = 0; i < n; i++) {
        dest[i] = source[i];
    }
}

void sortByProfit(struct Item item[], int n) {
    int i, j;
    struct Item temp;

    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {

            if(item[i].profit < item[j].profit) {
                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }
}

void sortByWeight(struct Item item[], int n) {
    int i, j;
    struct Item temp;

    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {

            if(item[i].weight > item[j].weight) {
                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }
}

void sortByRatio(struct Item item[], int n) {
    int i, j;
    struct Item temp;

    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {

            if(item[i].ratio < item[j].ratio) {
                temp = item[i];
                item[i] = item[j];
                item[j] = temp;
            }
        }
    }
}

void fractionalKnapsack(struct Item item[], int n, int capacity) {

    float x[n];
    int i;
    int remaining = capacity;
    float totalProfit = 0;
    float totalWeight = 0;

    for(i = 0; i < n; i++) {
        x[i] = 0.0;
    }

    for(i = 0; i < n; i++) {

        if(item[i].weight <= remaining) {

            x[i] = 1.0;

            remaining = remaining - item[i].weight;

            totalWeight = totalWeight + item[i].weight;

            totalProfit = totalProfit + item[i].profit;
        }
        else {

            x[i] = (float)remaining / item[i].weight;

            totalWeight = totalWeight + (x[i] * item[i].weight);

            totalProfit = totalProfit + (x[i] * item[i].profit);

            remaining = 0;

            break;
        }
    }

    printf("\nSolution Vector:\n");

    for(i = 0; i < n; i++) {
        printf("x[%d] = %.2f\n", i + 1, x[i]);
    }

    printf("\nTotal Weight = %.2f\n", totalWeight);

    printf("Maximum Profit = %.2f\n", totalProfit);
}

int main() {

    int n, capacity;
    int i;

    printf("Enter number of objects: ");
    scanf("%d", &n);

    struct Item original[n];

    printf("Enter knapsack capacity: ");
    scanf("%d", &capacity);

    printf("Enter profits:\n");

    for(i = 0; i < n; i++) {
        scanf("%d", &original[i].profit);
    }

    printf("Enter weights:\n");

    for(i = 0; i < n; i++) {

        scanf("%d", &original[i].weight);

        original[i].ratio =
            (float)original[i].profit / original[i].weight;
    }

    // 1. Maximum Profit
    struct Item byProfit[n];

    copyItems(original, byProfit, n);

    sortByProfit(byProfit, n);

    printf("\n====================================");
    printf("\nKnapsack by Maximum Profit");
    printf("\n====================================");

    fractionalKnapsack(byProfit, n, capacity);

    // 2. Minimum Weight
    struct Item byWeight[n];

    copyItems(original, byWeight, n);

    sortByWeight(byWeight, n);

    printf("\n\n====================================");
    printf("\nKnapsack by Minimum Weight");
    printf("\n====================================");

    fractionalKnapsack(byWeight, n, capacity);

    // 3. Maximum Profit/Weight Ratio
    struct Item byRatio[n];

    copyItems(original, byRatio, n);

    sortByRatio(byRatio, n);

    printf("\n\n====================================");
    printf("\nKnapsack by Maximum Profit/Weight Ratio");
    printf("\n====================================");

    fractionalKnapsack(byRatio, n, capacity);

    return 0;
}




