```java
// File: OddEvenThread.java
class SharedCounter {
    private int current;
    private int end;
    private boolean oddTurn;

    public SharedCounter() { current = 1; end = 20; oddTurn = true; }
    public SharedCounter(int start, int end) {
        current = start; this.end = end; oddTurn = (start % 2 != 0);
    }

    public int getCurrent() { return current; }
    public int getEnd() { return end; }
    public boolean isOddTurn() { return oddTurn; }

    public synchronized void printOdd() throws InterruptedException {
        while (current <= end) {
            if (!oddTurn) wait();
            if (current <= end && current % 2 != 0) {
                System.out.print(current + " ");
                current++;
                oddTurn = false;
                notifyAll();
            }
        }
    }

    public synchronized void printEven() throws InterruptedException {
        while (current <= end) {
            if (oddTurn) wait();
            if (current <= end && current % 2 == 0) {
                System.out.print(current + " ");
                current++;
                oddTurn = true;
                notifyAll();
            }
        }
    }
}

class OddThread extends Thread {
    private SharedCounter sc;
    public OddThread() { sc = new SharedCounter(); }
    public OddThread(SharedCounter sc) { this.sc = sc; }

    @Override
    public void run() {
        try { sc.printOdd(); }
        catch (InterruptedException e) { System.out.println("Odd thread interrupted."); }
    }
}

class EvenThread extends Thread {
    private SharedCounter sc;
    public EvenThread() { sc = new SharedCounter(); }
    public EvenThread(SharedCounter sc) { this.sc = sc; }

    @Override
    public void run() {
        try { sc.printEven(); }
        catch (InterruptedException e) { System.out.println("Even thread interrupted."); }
    }
}

