// File: BankAccount.java
public class BankAccount {
    private String depositorName;
    private long accountNo;
    private char accountType; // 'S' for Savings, 'C' for Current
    private double balance;

    private static final double MIN_SAVINGS = 1000.0;
    private static final double MIN_CURRENT = 25000.0;

    // Default Constructor
    public BankAccount() {
        depositorName = "";
        accountNo = 0;
        accountType = 'S';
        balance = 0.0;
    }

    // Parameterized Constructor
    public BankAccount(String name, long accNo, char type, double bal) {
        depositorName = name;
        accountNo = accNo;
        accountType = Character.toUpperCase(type);
        balance = bal;
    }

    // Getters and Setters
    public String getDepositorName() { return depositorName; }
    public long getAccountNo() { return accountNo; }
    public char getAccountType() { return accountType; }
    public double getBalance() { return balance; }

    public void setDepositorName(String name) { this.depositorName = name; }
    public void setAccountNo(long accNo) { this.accountNo = accNo; }
    public void setAccountType(char type) { this.accountType = Character.toUpperCase(type); }

    public void openAccount(String name, long accNo, char type, double initialDeposit) {
        this.depositorName = name;
        this.accountNo = accNo;
        this.accountType = Character.toUpperCase(type);
        double minBalance = (this.accountType == 'S') ? MIN_SAVINGS : MIN_CURRENT;
        if (initialDeposit < minBalance) {
            System.out.println("Initial deposit must be at least Rs " + minBalance
                    + " for " + (this.accountType == 'S' ? "Savings" : "Current") + " Account.");
        } else {
            this.balance = initialDeposit;
            System.out.println("Account opened successfully.");
        }
    }

    public void deposit(double amount) {
        if (amount <= 0) {
            System.out.println("Deposit amount must be positive.");
            return;
        }
        balance += amount;
        System.out.println("Rs " + amount + " deposited successfully.");
    }

    public void withdraw(double amount) {
        if (amount <= 0) {
            System.out.println("Withdrawal amount must be positive.");
            return;
        }
        double minBalance = (accountType == 'S') ? MIN_SAVINGS : MIN_CURRENT;
        if (balance - amount < minBalance) {
            System.out.println("Insufficient balance. Minimum balance of Rs "
                    + minBalance + " must be maintained.");
        } else {
            balance -= amount;
            System.out.println("Rs " + amount + " withdrawn successfully.");
        }
    }

    public void display() {
        System.out.println("\n--- Account Details ---");
        System.out.println("Depositor Name : " + depositorName);
        System.out.println("Account Number : " + accountNo);
        System.out.println("Account Type   : " + (accountType == 'S' ? "Savings" : "Current"));
        System.out.println("Balance        : Rs " + balance);
    }
}
