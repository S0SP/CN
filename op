// File: ComplexNum.java
public class ComplexNum {
    private double real;
    private double imag;

    // Default Constructor
    public ComplexNum() {
        real = 0;
        imag = 0;
    }

    // Parameterized Constructor
    public ComplexNum(double real, double imag) {
        this.real = real;
        this.imag = imag;
    }

    // Getters and Setters
    public double getReal() { return real; }
    public double getImag() { return imag; }
    public void setReal(double real) { this.real = real; }
    public void setImag(double imag) { this.imag = imag; }

    public void printComplex() {
        if (imag >= 0)
            System.out.println(real + " + " + imag + "i");
        else
            System.out.println(real + " - " + Math.abs(imag) + "i");
    }

    public ComplexNum addComplex(ComplexNum other) {
        return new ComplexNum(this.real + other.real, this.imag + other.imag);
    }

    public ComplexNum subComplex(ComplexNum other) {
        return new ComplexNum(this.real - other.real, this.imag - other.imag);
    }

    public ComplexNum multComplex(ComplexNum other) {
        double r = (this.real * other.real) - (this.imag * other.imag);
        double i = (this.real * other.imag) + (this.imag * other.real);
        return new ComplexNum(r, i);
    }
}
