    public void setReceiverNumber(String n) { this.receiverNumber = n; }
    public void setDurationMinutes(int d) { this.durationMinutes = d; }

    public int calculateUnits() {
        // 1 unit per 3 minutes, fractions count as full unit
        return (int) Math.ceil(durationMinutes / 3.0);
    }

    public double calculateCharge() {
        return calculateUnits() * RATE_PER_UNIT;
    }

