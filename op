```java
// File: CharPrintSequential.java
class SeqPrinter {
    private int turn; // 0=thread1, 1=thread2
    public SeqPrinter() { turn = 0; }

    public synchronized void printMessage(String msg, int threadId) throws InterruptedException {
        for (int i = 0; i < msg.length(); i++) {
            while (turn != threadId) wait();
            System.out.println(msg.charAt(i));
        }
        turn = (threadId + 1) % 2;
        notifyAll();
    }
}

class SeqThread extends Thread {
    private String message;
    private int threadId;
    private SeqPrinter printer;

    public SeqThread() { message = ""; threadId = 0; printer = new SeqPrinter(); }
    public SeqThread(String msg, int id, SeqPrinter p) {
        message = msg; threadId = id; printer = p;
    }

    @Override
    public void run() {
        try { printer.printMessage(message, threadId); }
        catch (InterruptedException e) { Thread.currentThread().interrupt(); }
    }
}

public class CharPrintSequential {
    public static void main(String[] args) throws InterruptedException {
        SeqPrinter printer = new SeqPrinter();
        SeqThread t1 = new SeqThread("Hello", 0, printer);
        SeqThread t2 = new SeqThread("World", 1, printer);
        t1.start();
        t2.start();
        t1.join();
        t2.join();
    }
}
```

