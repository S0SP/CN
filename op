class MaxFinder extends Thread {
    private int[] arr;
    private int max;

    public MaxFinder() { arr = new int[0]; max = Integer.MIN_VALUE; }
    public MaxFinder(int[] arr) { this.arr = arr; max = Integer.MIN_VALUE; }

    public int getMax() { return max; }

    @Override
    public void run() {
        for (int x : arr) {
            if (x > max) max = x;
        }
