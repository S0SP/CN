class AvgFinder extends Thread {
    private int[] arr;
    private double average;

    public AvgFinder() { arr = new int[0]; average = 0; }
    public AvgFinder(int[] arr) { this.arr = arr; average = 0; }

    public double getAverage() { return average; }

    @Override
    public void run() {
        long sum = 0;
        for (int x : arr) sum += x;
        average = (arr.length == 0) ? 0 : (double) sum / arr.length;
        System.out.println("Average found: " + average);
    }
}

