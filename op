public class Factorial {
    private static final int MAX_SIZE = 21;
    private long[] factorialCache;

    // Default Constructor
    public Factorial() {
        factorialCache = new long[MAX_SIZE];
        factorialCache[0] = 1;
        for (int i = 1; i < MAX_SIZE; i++) {
            factorialCache[i] = factorialCache[i - 1] * i;
        }
    }

