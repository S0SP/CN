// File: CharPrint3Thread.java
class ThreeThreadPrinter {
    private int turn; // 0,1,2
    private int numThreads;

    public ThreeThreadPrinter() { turn = 0; numThreads = 3; }
    public ThreeThreadPrinter(int numThreads) { turn = 0; this.numThreads = numThreads; }

    public synchronized void printChar(char c, int threadId) throws InterruptedException {
        while (turn != threadId) wait();
        System.out.println(c);
        turn = (turn + 1) % numThreads;
        notifyAll();
    }
}

class CharThread extends Thread {
    private String message;
    private int threadId;
    private ThreeThreadPrinter printer;
    private int totalChars; // to know when to stop waiting

    public CharThread() { message = ""; threadId = 0; printer = new ThreeThreadPrinter(); }
    public CharThread(String msg, int id, ThreeThreadPrinter p, int totalChars) {
        message = msg; threadId = id; printer = p; this.totalChars = totalChars;
    }

    @Override
    public void run() {
        for (int i = 0; i < message.length(); i++) {
            try {
                printer.printChar(message.charAt(i), threadId);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }
    }
}

public class CharPrint3Thread {
