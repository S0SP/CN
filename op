// File: ColorShapeForm.java
import java.applet.Applet;
import java.awt.*;
import java.awt.event.*;

/*
<applet code="ColorShapeForm.class" width="600" height="500">
</applet>
*/

public class ColorShapeForm extends Applet implements ActionListener {
    private TextField redField, greenField, blueField;
    private Choice shapeChoice;
    private Button drawBtn, clearBtn;
    private Color selectedColor;
    private String selectedShape;
    private boolean drawFlag;
    private Label statusLabel;

    public void init() {
        setLayout(new BorderLayout());
        setBackground(new Color(240, 240, 240));

        // Form Panel (North)
        Panel formPanel = new Panel(new GridLayout(5, 2, 5, 5));
        formPanel.setBackground(new Color(200, 220, 240));

        formPanel.add(new Label("Red (0-255):"));
        redField = new TextField("0");
        formPanel.add(redField);

        formPanel.add(new Label("Green (0-255):"));
        greenField = new TextField("0");
        formPanel.add(greenField);

        formPanel.add(new Label("Blue (0-255):"));
        blueField = new TextField("0");
        formPanel.add(blueField);

        formPanel.add(new Label("Select Shape:"));
        shapeChoice = new Choice();
        shapeChoice.add("Circle");
        shapeChoice.add("Rectangle");
        shapeChoice.add("Triangle");
        shapeChoice.add("Line");
        shapeChoice.add("Oval");
        formPanel.add(shapeChoice);

        drawBtn = new Button("Draw");
        drawBtn.setBackground(Color.GREEN);
        drawBtn.setFont(new Font("Arial", Font.BOLD, 14));
        drawBtn.addActionListener(this);
        formPanel.add(drawBtn);

        clearBtn = new Button("Clear");
        clearBtn.setBackground(Color.RED);
        clearBtn.setForeground(Color.WHITE);
        clearBtn.setFont(new Font("Arial", Font.BOLD, 14));
        clearBtn.addActionListener(this);
        formPanel.add(clearBtn);

        add(formPanel, BorderLayout.NORTH);

        // Status Label
        statusLabel = new Label("Select color and shape, then click Draw.");
        statusLabel.setFont(new Font("Arial", Font.ITALIC, 12));
        add(statusLabel, BorderLayout.SOUTH);

        selectedColor = Color.BLACK;
        selectedShape = "Circle";
        drawFlag = false;
    }

    public void actionPerformed(ActionEvent e) {
        if (e.getSource() == drawBtn) {
            try {
                int r = Integer.parseInt(redField.getText().trim());
                int g = Integer.parseInt(greenField.getText().trim());
                int b = Integer.parseInt(blueField.getText().trim());

                if (r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) {
                    statusLabel.setText("Error: RGB values must be 0-255.");
                    return;
                }
                selectedColor = new Color(r, g, b);
                selectedShape = shapeChoice.getSelectedItem();
                drawFlag = true;
                statusLabel.setText("Drawing: " + selectedShape +
                        " | Color: RGB(" + r + "," + g + "," + b + ")");
                repaint();
            } catch (NumberFormatException ex) {
                statusLabel.setText("Error: Please enter valid integers for RGB.");
            }
        } else if (e.getSource() == clearBtn) {
            drawFlag = false;
            statusLabel.setText("Canvas cleared.");
            repaint();
        }
    }

    public void paint(Graphics g) {
        // Draw canvas area
        g.setColor(Color.WHITE);
        g.fillRect(0, 160, 600, 300);
        g.setColor(Color.GRAY);
        g.drawRect(0, 160, 599, 299);

        if (!drawFlag) return;

        g.setColor(selectedColor);

        int cx = 200, cy = 280;
        switch (selectedShape) {
            case "Circle":
                g.fillOval(cx - 80, cy - 80, 160, 160);
                break;
            case "Rectangle":
                g.fillRect(cx - 100, cy - 60, 200, 120);
                break;
            case "Triangle":
                int[] xp = {cx, cx - 100, cx + 100};
                int[] yp = {cy - 80, cy + 60, cy + 60};
                g.fillPolygon(xp, yp, 3);
                break;
            case "Line":
                g.drawLine(cx - 100, cy, cx + 100, cy);
                break;
            case "Oval":
                g.fillOval(cx - 120, cy - 60, 240, 120);
                break;
        }

        // Label the shape
        g.setColor(Color.BLACK);
        g.setFont(new Font("Arial", Font.BOLD, 14));
        g.drawString(selectedShape + " drawn!", cx - 40, cy + 110);
    }
}
