public class OddSum2D {
    private int[][] matrix;
    private int rows;
    private int cols;

    // Default Constructor
    public OddSum2D() {
        rows = 0; cols = 0;
        matrix = new int[0][0];
    }

    // Parameterized Constructor
    public OddSum2D(int[][] matrix) {
        this.rows = matrix.length;
        this.cols = matrix[0].length;
        this.matrix = matrix;
    }

    // Getter and Setter
    public int[][] getMatrix() { return matrix; }
    public void setMatrix(int[][] matrix) {
        this.matrix = matrix;
        this.rows = matrix.length;
        this.cols = matrix[0].length;
    }

    public long sumOfOdd() {
        long sum = 0;
        for (int i = 0; i < rows; i++)
            for (int j = 0; j < cols; j++)
                if (matrix[i][j] % 2 != 0) sum += matrix[i][j];
        return sum;
    }

    public void display() {
        for (int[] row : matrix) {
            for (int val : row) System.out.printf("%5d", val);
            System.out.println();
        }
    }
}
