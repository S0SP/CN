        rows = n; cols = n;
        data = new int[n][n];
    }

    // Constructor for MxN matrix
    public Matrix(int m, int n) {
        rows = m; cols = n;
        data = new int[m][n];
    }

    // Getters
    public int getRows() { return rows; }
    public int getCols() { return cols; }
    public int[][] getData() { return data; }

    public void getData(java.util.Scanner sc) {
        System.out.println("Enter elements (" + rows + "x" + cols + "):");
        for (int i = 0; i < rows; i++)
            for (int j = 0; j < cols; j++)
                data[i][j] = sc.nextInt();
    }

    public void printMat() {
        for (int[] row : data) {
            for (int val : row) System.out.printf("%5d", val);
            System.out.println();
        }
    }

    public Matrix addMat(Matrix other) {
        if (this.rows != other.rows || this.cols != other.cols) {
            System.out.println("Matrix dimensions do not match for addition.");
            return null;
        }
        Matrix result = new Matrix(rows, cols);
        for (int i = 0; i < rows; i++)
            for (int j = 0; j < cols; j++)
                result.data[i][j] = this.data[i][j] + other.data[i][j];
        return result;
    }

    public boolean multMat(Matrix a, Matrix b) {
        if (a.cols != b.rows) {
            System.out.println("Multiplication not possible.");
            return false;
        }
        this.rows = a.rows;
        this.cols = b.cols;
        this.data = new int[this.rows][this.cols];
        for (int i = 0; i < a.rows; i++)
            for (int j = 0; j < b.cols; j++)
                for (int k = 0; k < a.cols; k++)
                    this.data[i][j] += a.data[i][k] * b.data[k][j];
        return true;
    }
}
