public class Car {
    private int speed;
    private boolean isStarted;

    // Default Constructor
    public Car() {
        speed = 0;
        isStarted = false;
    }

    // Parameterized Constructor
    public Car(int speed, boolean isStarted) {
        this.speed = speed;
        this.isStarted = isStarted;
    }

    // Getters and Setters
    public int getSpeed() { return speed; }
    public boolean getIsStarted() { return isStarted; }

    public void carStart() {
        if (isStarted) {
            System.out.println("Car is already started.");
        } else {
            isStarted = true;
            speed = 30;
            System.out.println("Car started.");
            printSpeed();
        }
    }

    public void carSlow() {
        if (!isStarted) {
            System.out.println("Car is not started yet.");
            return;
        }
        if (speed - 20 < 0) {
            System.out.println("Cannot reduce speed. Car speed cannot be negative.");
        } else {
            speed -= 20;
            printSpeed();
        }
    }

    public void carFast() {
        if (!isStarted) {
            System.out.println("Car is not started yet.");
            return;
        }
        if (speed + 30 > 200) {
            System.out.println("Cannot accelerate. Max speed limit is 200.");
        } else {
            speed += 30;
            printSpeed();
        }
    }

    public void printSpeed() {
        System.out.println("Current Speed: " + speed + " km/h");
    }
}
