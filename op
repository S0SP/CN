    private static final double RATE_PER_UNIT = 1.0; // 1 unit per 3 min

    // Default Constructor
    public LocalCall() {
        callerNumber = "";
        receiverNumber = "";
        durationMinutes = 0;
    }

    // Parameterized Constructor
    public LocalCall(String caller, String receiver, int duration) {
        this.callerNumber = caller;
        this.receiverNumber = receiver;
