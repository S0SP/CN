// File: ArrayOps.java
public class ArrayOps {
    private int[] arr;
    private int size;

    // Default Constructor
    public ArrayOps() {
        size = 0;
        arr = new int[0];
    }

    // Parameterized Constructor
    public ArrayOps(int[] arr) {
        this.size = arr.length;
        this.arr = arr;
    }

    // Getter and Setter
    public int[] getArr() { return arr; }
    public void setArr(int[] arr) { this.arr = arr; this.size = arr.length; }

    public long sum() {
        long total = 0;
        for (int x : arr) total += x;
        return total;
    }

    public double average() {
        if (size == 0) return 0;
        return (double) sum() / size;
    }
}
