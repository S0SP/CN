public class LongCall {
    private String callerNumber;
    private String receiverNumber;
    private int durationMinutes;
    private int callHour;        // 0-23
    private String originCode;
    private String destCode;

    /*
     * Rate Table (as per assignment):
     * Day (8am-8pm):    Rs 2.00/min
     * Evening (8pm-11pm): Rs 1.50/min
     * Night (11pm-8am): Rs 1.00/min
     * Interstate (different area codes): additional 50% surcharge
     */

    // Default Constructor
    public LongCall() {
        callerNumber = "";
        receiverNumber = "";
        durationMinutes = 0;
        callHour = 0;
        originCode = "";
        destCode = "";
    }

    // Parameterized Constructor
    public LongCall(String caller, String receiver, int duration,
                    int hour, String originCode, String destCode) {
        this.callerNumber = caller;
        this.receiverNumber = receiver;
        this.durationMinutes = duration;
        this.callHour = hour;
        this.originCode = originCode;
        this.destCode = destCode;
    }

    // Getters and Setters
    public String getCallerNumber() { return callerNumber; }
    public String getReceiverNumber() { return receiverNumber; }
    public int getDurationMinutes() { return durationMinutes; }
    public int getCallHour() { return callHour; }
    public String getOriginCode() { return originCode; }
    public String getDestCode() { return destCode; }
    public void setCallerNumber(String n) { this.callerNumber = n; }
    public void setReceiverNumber(String n) { this.receiverNumber = n; }
    public void setDurationMinutes(int d) { this.durationMinutes = d; }
    public void setCallHour(int h) { this.callHour = h; }
    public void setOriginCode(String c) { this.originCode = c; }
    public void setDestCode(String c) { this.destCode = c; }

    public double getRatePerMinute() {
        if (callHour >= 8 && callHour < 20) return 2.00;
        else if (callHour >= 20 && callHour < 23) return 1.50;
        else return 1.00;
    }

    public double calculateCharge() {
        double rate = getRatePerMinute();
        double charge = rate * durationMinutes;
        // Add 50% surcharge if interstate (different codes)
        if (!originCode.equalsIgnoreCase(destCode)) {
            charge *= 1.5;
        }
        return charge;
    }

    public void displayBill() {
        System.out.println("\n--- Long Distance (STD) Call Bill ---");
        System.out.println("Caller        : " + callerNumber);
        System.out.println("Receiver      : " + receiverNumber);
        System.out.println("Duration      : " + durationMinutes + " minutes");
        System.out.println("Call Time     : " + callHour + ":00");
        System.out.println("Origin Code   : " + originCode);
        System.out.println("Dest Code     : " + destCode);
        System.out.println("Rate/min      : Rs " + getRatePerMinute());
        System.out.println("Total Charge  : Rs " + calculateCharge());
    }
}
