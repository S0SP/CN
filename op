        System.out.println("\n--- Local Call Bill ---");
        System.out.println("Caller        : " + callerNumber);
        System.out.println("Receiver      : " + receiverNumber);
        System.out.println("Duration      : " + durationMinutes + " minutes");
        System.out.println("Units         : " + calculateUnits());
        System.out.println("Charge        : Rs " + calculateCharge());
